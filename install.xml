            }
    ]]></add></operation>
    <operation error="skip"><search><![CDATA[$captcha = $this->load->controller('extension/captcha/' . $this->config->get('config_captcha') . '/validate');]]></search><add position="after"><![CDATA[
                if ($this->config->get('captcha_honeypot_status') && $this->config->get('config_captcha') != 'honeypot') {
