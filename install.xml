<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Honeypot Anti-Spam CAPTCHA</name>
  <code>honeypot_antispam_captcha</code>
  <version>1.2.0</version>
  <author>Dmitry Matveev &lt;d.a.matveev@gmail.com&gt;</author>
  <link>https://boosty.to/matveevd/donate</link>

  <file path="catalog/controller/account/register.php">
    <operation>
      <search><![CDATA[$data['captcha'] = $this->load->controller('extension/captcha/' . $this->config->get('config_captcha'), $this->error);]]></search>
      <add position="after"><![CDATA[
            if ($this->config->get('captcha_honeypot_status')) {
                $yandex_ready = $this->config->get('captcha_yandex_status') && $this->config->get('captcha_yandex_key') && $this->config->get('captcha_yandex_secret');
                $yandex_primary = $this->config->get('config_captcha') == 'yandex';
                if ($yandex_ready && !$yandex_primary) {
                    $data['captcha'] .= $this->load->controller('extension/captcha/yandex', $this->error);
                }
                $data['captcha'] .= $this->load->controller('extension/captcha/honeypot', $this->error);
            }
      ]]></add>
    </operation>
    <operation>
      <search><![CDATA[$captcha = $this->load->controller('extension/captcha/' . $this->config->get('config_captcha') . '/validate');]]></search>
      <add position="after"><![CDATA[
            if ($this->config->get('captcha_honeypot_status')) {
                $honeypot = $this->load->controller('extension/captcha/honeypot/validate');
                if ($honeypot) {
                    $this->error['captcha'] = $honeypot;
                }
            }
      ]]></add>
    </operation>
  </file>

