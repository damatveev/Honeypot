{% if yandex_enabled %}
<script src="https://smartcaptcha.cloud.yandex.ru/captcha.js" defer></script>
<fieldset class="hp-yandex-smartcaptcha">
  <legend>Yandex SmartCaptcha</legend>
  <div class="form-group required">
    <label class="col-sm-2 control-label">Проверка</label>
    <div class="col-sm-10">
      <div class="smart-captcha" data-sitekey="{{ yandex_site_key }}"></div>
      {% if yandex_error %}<div class="text-danger">{{ yandex_error }}</div>{% endif %}
    </div>
  </div>
</fieldset>
{% endif %}

<div class="hp-antispam" aria-hidden="true" style="position:absolute!important;left:-10000px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;opacity:0!important;pointer-events:none!important;">
  <label for="{{ field_name }}">Website</label>
  <input type="text" id="{{ field_name }}" name="{{ field_name }}" value="" tabindex="-1" autocomplete="off" autocapitalize="off" spellcheck="false">
  <label for="{{ field_name_2 }}">Company</label>
  <input type="text" id="{{ field_name_2 }}" name="{{ field_name_2 }}" value="" tabindex="-1" autocomplete="off" autocapitalize="off" spellcheck="false">
  <input type="hidden" name="_hp_token" value="{{ hp_token }}">
  <input type="hidden" name="{{ js_name }}" value="" data-hp-js-proof="{{ js_value }}">
</div>
<script>
(function() {
  {% if phone_ru_enabled %}
  function isTelephoneInput(node) {
    return node && node.matches && (
      node.matches('input[name="telephone"]') ||
      node.matches('input[name="register[telephone]"]')
    );
  }

  function getRussianDigits(value) {
    var digits = String(value || '').replace(/\D+/g, '');

    if (digits.length === 11 && (digits.charAt(0) === '7' || digits.charAt(0) === '8')) {
      return digits.substring(1);
    }

    if (digits.length === 10 && digits.charAt(0) === '9') {
      return digits;
    }

    return '';
  }

  function removeThirdPartyPhoneMask(node) {
    if (!isTelephoneInput(node)) {
      return;
    }

    try {
      if (node.inputmask && typeof node.inputmask.remove === 'function') {
        node.inputmask.remove();
      }
    } catch (ignoreInputmask) {}

    try {
      if (window.jQuery) {
        var phone = window.jQuery(node);

        if (node.inputmask && typeof phone.inputmask === 'function') {
          phone.inputmask('remove');
        }

        if (typeof phone.unmask === 'function') {
          phone.unmask();
        }
      }
    } catch (ignoreJqueryMask) {}

    node.removeAttribute('data-mask');
    node.removeAttribute('data-simple-mask');
    node.setAttribute('inputmode', 'tel');
  }

  function formatRussianPhone(node, sourceDigits) {
    if (!isTelephoneInput(node)) {
      return;
    }

    var digits = sourceDigits || getRussianDigits(node.value);
    if (!digits) {
      return;
    }

    node.value = '+7 (' + digits.substring(0, 3) + ') '
      + digits.substring(3, 6) + '-' + digits.substring(6, 8)
      + '-' + digits.substring(8, 10);
  }

  function preserveAutofillValue(node) {
    var digits = getRussianDigits(node.value);
    if (!digits) {
      return;
    }

    window.setTimeout(function() {
      removeThirdPartyPhoneMask(node);
      formatRussianPhone(node, digits);
    }, 0);
  }

  document.addEventListener('focusin', function(event) {
    var node = event.target;
    if (!isTelephoneInput(node)) {
      return;
    }

    window.setTimeout(function() {
      removeThirdPartyPhoneMask(node);
    }, 0);
  }, true);

  document.addEventListener('input', function(event) {
    if (isTelephoneInput(event.target)) {
      preserveAutofillValue(event.target);
    }
  }, true);

  document.addEventListener('paste', function(event) {
    var node = event.target;
    if (!isTelephoneInput(node) || !event.clipboardData) {
      return;
    }

    var digits = getRussianDigits(event.clipboardData.getData('text'));
    if (!digits) {
      return;
    }

    event.preventDefault();
    removeThirdPartyPhoneMask(node);
    formatRussianPhone(node, digits);
    node.dispatchEvent(new Event('input', { bubbles: true }));
  }, true);

  document.addEventListener('blur', function(event) {
    if (isTelephoneInput(event.target)) {
      removeThirdPartyPhoneMask(event.target);
      formatRussianPhone(event.target);
    }
  }, true);
  {% endif %}

  var node = document.querySelector('input[name="{{ js_name }}"][data-hp-js-proof]');
  if (node) {
    window.setTimeout(function() {
      node.value = node.getAttribute('data-hp-js-proof');
    }, 600);
  }
})();
</script>
